# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Assembled at vercel-build from public/*/chunks — do not commit binaries.
/public/sprites/*/*.webp
/public/focus/*.jpg
/public/*.zip
/dist/

# Generated focus plate modules (bootstrap-github.mjs deletes these).
/src/lib/focus-plates.ts
/src/lib/focus-plates-cat.ts
/src/lib/focus-plates-desk.ts
/src/lib/focus-plates-library.ts
/src/app/api/plates/

# Local recordings / walkthroughs
*.mp4
*.webm
*.mov

# Legacy split sidecars (full plates live at public/sprites/{species}/{stage}.webp).
# Keep the directory ignored if someone dumps huge scratch files here; tracked
# .b64 files are force-added when we need a GitHub-safe text overlay.
