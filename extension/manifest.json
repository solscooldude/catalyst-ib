{
  "manifest_version": 3,
  "name": "Catalyst Lock",
  "version": "0.4.0",
  "description": "Block distracting sites when Catalyst Lock is on. Lock hours and study blocks keep it on. School tools stay open.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://catalyst-study.vercel.app/*",
        "https://catalyst-focus.vercel.app/*",
        "https://catalyst-ib.vercel.app/*",
        "http://localhost:43127/*",
        "http://127.0.0.1:43127/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Catalyst Lock",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["locked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
