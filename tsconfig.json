{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/schedule.test.ts",
    "src/lib/stats.test.ts",
    "src/lib/pet-quiz.test.ts",
    "src/lib/study-style.test.ts",
    "src/lib/species-glows.test.ts",
    "src/lib/sprite-art.test.ts",
    "src/lib/egg-hatch.test.ts",
    "src/lib/spark-play.test.ts",
    "src/lib/friends.test.ts"
  ]
}
